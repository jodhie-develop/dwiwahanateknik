{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "regions": ["sin1"],
    "installCommand": "npm ci",
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4",
            "memory": 1024,
            "maxDuration": 60,
            "excludeFiles": "{node_modules/**,tests/**,database/*.sqlite*,storage/logs/**,storage/app/private/**,.github/**,*.md}"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "headers": { "cache-control": "public, max-age=31536000, immutable" },
            "dest": "/build/$1"
        },
        {
            "src": "/sw\\.js",
            "headers": { "cache-control": "no-cache", "service-worker-allowed": "/" },
            "dest": "/sw.js"
        },
        { "src": "/(manifest\\.webmanifest|favicon\\.ico|robots\\.txt)", "dest": "/$1" },
        { "src": "/icons/(.*)", "dest": "/icons/$1" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "crons": [
        { "path": "/cron/bersihkan-upload-sementara", "schedule": "0 19 * * *" }
    ]
}
