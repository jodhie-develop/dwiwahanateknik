APP_NAME="Dwi Wahana Teknik"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: Supabase (PostgreSQL) ---
# Pakai session pooler (port 5432) dari Supabase > Project Settings > Database > Connection string.
# Jika terpaksa memakai transaction pooler (port 6543), set DB_EMULATE_PREPARES=true.
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_SSLMODE=require
DB_EMULATE_PREPARES=false

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# --- File: Supabase Storage (S3-compatible) ---
# Supabase > Storage > S3 Connection: buat access key. Bucket dibuat PRIVAT.
FILESYSTEM_DISK=supabase
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_KEY=
SUPABASE_S3_SECRET=
SUPABASE_BUCKET=

# Upload sementara Livewire disimpan lokal dulu, baru dipindah ke Supabase.
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Seeder awal (hanya untuk `php artisan db:seed`) ---
SEED_CABANG_KODE=SBY
SEED_CABANG_NAMA="Surabaya"
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=
SEED_ADMIN_USERNAME=admin.sby
SEED_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# --- Push notification (PWA teknisi). Buat kunci: php artisan webpush:vapid ---
# Di Windows lokal, jalankan dengan env OPENSSL_CONF=<php>/extras/ssl/openssl.cnf
VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
